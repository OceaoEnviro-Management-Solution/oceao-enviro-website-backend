# Copy this file to .env and adjust. Never commit real secrets.

# -- Production values --------------------------------------------------------
# Set these in the host's environment (never in a committed file). The values below this
# block are for local development.
#
#   NODE_ENV=production        5xx responses become a generic INTERNAL_ERROR; the admin
#                              cookie gets the Secure flag (HTTPS only)
#   CORS_ORIGINS=https://www.your-domain.example
#                              the exact https origin(s) of the frontend: no "*", no trailing
#                              slash. The admin CSRF check compares the Origin header to this list.
#   TRUST_PROXY=1              number of proxies in front of the app (1 behind a single host
#                              proxy). With 0 behind a proxy every visitor shares one IP, so
#                              the rate limiters would count everyone together.
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>   (Atlas; never log or commit)
#   EMAIL_MODE=smtp            plus SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASSWORD
#   TURNSTILE_SECRET_KEY       the real secret from the Cloudflare dashboard (the test key
#                              further down always passes, so it must not be used in production)
#   OTP_SECRET, BOOKING_TOKEN_SECRET, ADMIN_JWT_SECRET
#                              three different random values of at least 32 characters, e.g.
#                              node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ADMIN_EMAIL, ADMIN_PASSWORD_HASH
#                              the real login; make the hash with: npm run admin:hash
#   GOOGLE_*                   set all three of CLIENT_ID, CLIENT_SECRET and REFRESH_TOKEN to enable Meet
#
# Fixed in code, not in the environment (src/config/security.js): JSON and form body limit
# 20kb, upload limits (5 MB, 1 file, 10 fields, 10 KB each), helmet defaults, the admin cookie
# flags (httpOnly, SameSite=Lax, path /api/v1/admin, 8 hours) and the rate limits per IP per
# 15 minutes (public forms 5, OTP send 10, OTP verify 10, admin login 5, all of /api 300).

# Runtime mode: development | test | production
NODE_ENV=development
# Port the API listens on
PORT=8000
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/oceao-enviro
# Comma-separated frontend origins allowed by CORS (also used for admin CSRF checks)
CORS_ORIGINS=http://localhost:5173
# Proxy hops to trust: 0 locally, 1 behind a host proxy
TRUST_PROXY=0

# Email transport: log (print to console) | smtp (real send) | test (in-memory outbox)
EMAIL_MODE=log
# "From" address on all outgoing mail
MAIL_FROM=Oceao Enviro <no-reply@example.com>
# Inbox that receives query, feedback, booking and callback notifications
COMPANY_MAIL=info@example.com

# SMTP settings (only used when EMAIL_MODE=smtp)
# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP server port
SMTP_PORT=587
# true for port 465 (implicit TLS), false for STARTTLS on 587
SMTP_SECURE=false
# SMTP login user
SMTP_USER=smtp-user@example.com
# SMTP login password
SMTP_PASSWORD=change-me

# Secret for hashing OTP codes (at least 32 characters)
OTP_SECRET=dummy-otp-secret-change-me-0123456789abcdef
# Secret for signing VM booking tokens (at least 32 characters)
BOOKING_TOKEN_SECRET=dummy-booking-token-secret-change-me-0123456789

# Google Meet (optional): leave these commented out to disable Meet link creation
# Google OAuth client ID
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google OAuth client secret
# GOOGLE_CLIENT_SECRET=your-client-secret
# Refresh token for the calendar owner (generated by the google-auth script)
# GOOGLE_REFRESH_TOKEN=your-refresh-token
# Calendar that receives VM events (defaults to primary)
GOOGLE_CALENDAR_ID=primary

# Cloudflare Turnstile secret; this is Cloudflare's public always-pass test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin login email
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password (generate with npm run admin:hash)
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Secret for signing admin session JWTs (at least 32 characters)
ADMIN_JWT_SECRET=dummy-admin-jwt-secret-change-me-0123456789abcdef
